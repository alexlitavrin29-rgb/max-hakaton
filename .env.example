# MAX: вставьте токен вашего бота после знака =.
MAX_BOT_TOKEN=

# Polza.ai: ключ используется только backend-модулем LLM.
POLZA_API_KEY=
# Для ProxyAPI: LLM_PROVIDER=proxyapi и LLM_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_API_KEY=
LLM_PROVIDER=polza
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30

# Модуль LLM реализован; подключение MAX пока предстоит добавить.
# Не отправляйте заполненный .env в чат и не добавляйте его в Git.

# Локальная инфраструктура. Замените CHANGE_ME_* своими паролями.
POSTGRES_DB=support_router
POSTGRES_USER=support_router
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_PORT=5432
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=support_router
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ
RABBITMQ_PORT=5672

# ReefAPI city/budget rental pilot. Used only when rental.enabled is set in the scenario.
HOUSING_API_KEY=

# HeadHunter application credentials; issue an application token once via /token.
# Runtime search uses HH_ACCESS_TOKEN, never regenerates it on each restart.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_USER_AGENT=TochkaOpory/1.0 (https://135-106-229-210.sslip.io/)
