FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY project/llm/requirements-llm.txt project/llm/requirements-bot.txt /app/requirements/
RUN pip install --no-cache-dir -r /app/requirements/requirements-bot.txt
RUN groupadd --system appuser && useradd --system --gid appuser --no-create-home appuser
COPY --chown=appuser:appuser project/llm /app/project/llm
COPY --chown=appuser:appuser project/data/knowledge /app/project/data/knowledge
COPY --chown=appuser:appuser project/admin/seed.py /app/project/admin/seed.py
RUN mkdir -p /app/project/logs /app/project/cache && chown appuser:appuser /app/project/logs /app/project/cache
USER appuser
CMD ["python", "-m", "project.llm.bot"]
